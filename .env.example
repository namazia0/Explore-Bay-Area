# ─────────────────────────────────────────────────────────────
# Apify — powers the live event layer.
# Get a token at https://console.apify.com/settings/integrations
# Without it the app runs on the curated Bay Area atlas instead.
# ─────────────────────────────────────────────────────────────
APIFY_TOKEN=

# Actor that scrapes Eventbrite search/discovery pages.
# Pay-per-result, from $3.00 / 1,000 results ($0.003 each).
APIFY_ACTOR_ID=hypebridge/eventbrite-search

# Work cap — how many events the Actor is asked to scrape per run.
APIFY_MAX_EVENTS=60

# Bill cap in USD, applied per run as a call option (maxTotalChargeUsd).
# This is the hard ceiling on what a single live search can cost.
APIFY_MAX_USD=0.5

# How long a live result set is reused before another run is allowed (ms).
APIFY_CACHE_TTL_MS=1800000

# Seconds to wait for an Actor run before giving up.
APIFY_TIMEOUT_SECS=180
